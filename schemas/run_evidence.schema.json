{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipelines.run-evidence.v5",
  "type": "object",
  "required": ["schema_version", "governance_version", "pipeline_id", "run_id", "execution_status", "learning_status", "started_at", "finished_at", "checkpointed_at", "reconciled", "summary", "attempts", "rejected_artifacts", "observations", "metrics", "hypotheses", "recommendations"],
  "properties": {
    "schema_version": {"enum": [4, 5]},
    "governance_version": {"enum": ["deterministic-semantic-human-v1", "deterministic-semantic-human-v2"]},
    "pipeline_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "execution_status": {"enum": ["running", "succeeded", "partially_succeeded", "failed", "interrupted", "bounded_stop", "no_op"]},
    "learning_status": {"enum": ["not_required", "pending", "completed", "skipped", "failed"]},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]},
    "checkpointed_at": {"type": ["string", "null"]},
    "reconciled": {"type": "boolean"},
    "summary": {"type": "object"},
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attempt_id", "entity_id", "stage", "status", "failure_class", "authority", "explanation", "started_at", "finished_at"],
        "properties": {
          "attempt_id": {"type": "string"},
          "entity_id": {"type": "string"},
          "stage": {"type": "string"},
          "status": {"type": "string"},
          "failure_class": {"enum": ["none", "transport", "parse", "schema", "deterministic", "heuristic_escalation", "semantic", "human", "interruption", "orchestration"]},
          "authority": {"enum": ["deterministic", "semantic_model", "human", "none"]},
          "validator_or_reviewer": {"type": ["string", "null"]},
          "explanation": {"type": ["string", "null"]},
          "thread_path": {"type": ["string", "null"]},
          "artifact_path": {"type": ["string", "null"]},
          "explanation_path": {"type": ["string", "null"]},
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "rejected_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attempt_id", "entity_id", "path", "explanation_path", "evidence_format", "sequence", "artifact_role", "content_format", "parent_candidate_path", "parent_candidate_sha256", "child_evidence_paths", "candidate_sha256", "explanation"],
        "properties": {
          "attempt_id": {"type": ["string", "null"]},
          "entity_id": {"type": ["string", "null"]},
          "path": {"type": "string", "minLength": 1},
          "explanation_path": {"type": ["string", "null"]},
          "evidence_format": {"enum": ["sidecar", "legacy_appended"]},
          "sequence": {"type": ["integer", "null"], "minimum": 1},
          "artifact_role": {"enum": ["candidate", "precursor", "diagnostic_render", "diagnostic_render_failure", "legacy"]},
          "content_format": {"type": ["string", "null"]},
          "parent_candidate_path": {"type": ["string", "null"]},
          "parent_candidate_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "child_evidence_paths": {"type": "array", "items": {"type": "string"}},
          "candidate_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "explanation": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"evidence_format": {"const": "sidecar"}}},
            "then": {
              "properties": {
                "explanation_path": {"type": "string", "minLength": 1},
                "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          },
          {
            "if": {"properties": {"evidence_format": {"const": "legacy_appended"}}},
            "then": {"properties": {"explanation_path": {"type": "null"}}}
          }
        ],
        "additionalProperties": true
      }
    },
    "observations": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "object"},
    "hypotheses": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
